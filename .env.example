# Worker Application
PORT=5001
NODE_ENV=development

# Hubsman Backend Integration (hubsman-v2 en 5000 y hubsman-core en 30066)
HUBSMAN_API_URL=http://localhost:5000,http://localhost:30066
SERVICE_API_KEY=hubsman_task_service_secret_key_2026

# Task Scheduling & Batch configuration
# Formato de 6 campos (segundo minuto hora dia mes dia-de-semana). */20 * * * * * = cada 20 segundos
CRON_SCHEDULE=*/20 * * * * *
BATCH_SIZE=10

# Microsoft 365 / Azure Entra ID Graph API
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_MAIL_FROM=hubsmannotificaciones@hubsman.com
MAIL_FROM_NAME=Hubsman
MAIL_REPLY_TO=tecnologia@hubsman.com
